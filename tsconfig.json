{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["extensions/**/*.ts", "lib/**/*.ts"],
  "exclude": ["**/tests/**", "**/fixtures/**", "**/node_modules/**"]
}
