{
  "lastChangelogVersion": "0.87.1",
  "theme": "light",
  "followUpMode": "all",
  "defaultProjectTrust": "never",
  "extensions": ["-builtin:mcp"],
  "defaultProvider": "grob",
  "defaultModel": "default-model",
  "packages": [
    "npm:pi-simplify@0.2.3",
    "git:github.com/DietrichGebert/ponytail@16352ac229eb08a9598dcae48fe9f2b342567d86",
    {
      "source": "npm:@ian-pascoe/pi-lsp@0.14.2",
      "extensions": [],
      "skills": []
    },
    {
      "source": "npm:typescript@7.0.2",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:@richardgill/pi-background-bash@0.0.3",
      "extensions": []
    },
    "git:github.com/emilkowalski/skills@2d228630ba1446365f614a108cb8252f1feda202"
  ],
  "lsp": {
    "servers": {
      "typescript": {
        "command": "tsc",
        "args": [
          "--lsp",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          },
          {
            "extensions": [".js", ".mjs", ".cjs"],
            "languageId": "javascript"
          },
          {
            "extensions": [".jsx"],
            "languageId": "javascriptreact"
          }
        ],
        "requireRootMarker": true,
        "rootMarkers": [
          "tsconfig.json",
          "jsconfig.json",
          "package.json",
          ".git"
        ]
      }
    }
  }
}
