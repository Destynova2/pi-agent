{
  "lastChangelogVersion": "0.87.1",
  "theme": "light",
  "followUpMode": "all",
  "extensions": ["-builtin:mcp"],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-fable-5-1",
  "packages": [
    "npm:pi-simplify@0.2.3",
    "git:github.com/DietrichGebert/ponytail@e3ba2aa6f1e6f0bc4d69eb09c9f0d0a93af56156",
    {
      "source": "npm:@ian-pascoe/pi-lsp@0.4.4",
      "extensions": []
    },
    {
      "source": "npm:typescript@7.0.2",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:@richardgill/pi-background-bash@0.0.3",
      "extensions": []
    },
    "git:github.com/emilkowalski/skills@d16ebe60d09a5ba2afcb7054ede9d0a10c9f6128"
  ],
  "lsp": {
    "servers": {
      "typescript": {
        "command": "tsc",
        "args": [
          "--lsp",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          },
          {
            "extensions": [".js", ".mjs", ".cjs"],
            "languageId": "javascript"
          },
          {
            "extensions": [".jsx"],
            "languageId": "javascriptreact"
          }
        ],
        "requireRootMarker": true,
        "rootMarkers": [
          "tsconfig.json",
          "jsconfig.json",
          "package.json",
          ".git"
        ]
      }
    }
  }
}
