FROM mcr.microsoft.com/playwright/mcp@sha256:77dccc5ce9e94cb8ae7ebea87ddbb6cd54b05760c4d63c54e16accf2726b8734

USER root
RUN npm install --prefix /opt/pi-browser --ignore-scripts --omit=dev --no-audit --no-fund --save-exact @playwright/mcp@0.0.83 \
    && node /opt/pi-browser/node_modules/playwright-core/cli.js install --no-shell chromium
LABEL io.pi-agent.browser-mcp.version="0.0.83"
COPY entrypoint.mjs /opt/pi-browser/entrypoint.mjs
USER node
WORKDIR /tmp
ENTRYPOINT ["node", "/opt/pi-browser/entrypoint.mjs"]
