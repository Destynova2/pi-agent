index 0000000..fa1b6c5
--- /dev/null
+++ b/codex-rs/cli/src/debug_sandbox/metal.rs
@@ -0,0 +1,32 @@
+//! Opt-in Metal access for the standalone sandbox command, never agent commands.
+//! The caller is responsible for approving and supervising the command tree.
+
+const XPC_DENY: &str = "(deny mach-lookup (xpc-service-name-prefix \"\"))";
+const METAL_XPC_DENY: &str = r#"(deny mach-lookup
+  (require-all
+    (xpc-service-name-prefix "")
+    (require-not (xpc-service-name "com.apple.MTLCompilerService"))))"#;
+const METAL_POLICY: &str = r#"
+(allow iokit-open
+  (iokit-user-client-class "IOSurfaceRootUserClient")
+  (iokit-user-client-class "AGXDeviceUserClient"))
+(allow mach-lookup (xpc-service-name "com.apple.MTLCompilerService"))
+"#;
+
+pub(super) fn enable(policy: &mut String) -> Result<(), &'static str> {
+    if !cfg!(target_arch = "aarch64") {
+        return Err("--allow-metal is only qualified for Apple Silicon");
+    }
+    // Fail closed if the generator's XPC protection contract changes. Exempt
+    // only Apple's shader compiler; retain the deny for every other XPC service.
+    if policy.matches(XPC_DENY).count() != 1 {
+        return Err("Metal access requires the expected XPC deny policy");
+    }
+    *policy = policy.replacen(XPC_DENY, METAL_XPC_DENY, 1);
+    policy.push_str(METAL_POLICY);
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "metal_tests.rs"]
+mod tests;
