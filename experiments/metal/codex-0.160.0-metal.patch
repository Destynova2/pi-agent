@@ -0,0 +1,39 @@
+use super::enable;
+use clap::Parser;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn metal_cannot_widen_an_imported_sandbox_state() {
+    let error = crate::SeatbeltCommand::try_parse_from([
+        "sandbox",
+        "--allow-metal",
+        "--sandbox-state-json",
+        "{}",
+        "--",
+        "true",
+    ])
+    .unwrap_err();
+    assert_eq!(error.kind(), clap::error::ErrorKind::ArgumentConflict);
+}
+
+#[test]
+fn invalid_policy_is_not_modified() {
+    let original = "(version 1)(deny default)".to_string();
+    let mut policy = original.clone();
+    assert!(enable(&mut policy).is_err());
+    assert_eq!(policy, original);
+}
+
+#[test]
+#[cfg(target_arch = "aarch64")]
+fn metal_access_preserves_restrictions_and_rejects_reapplication() {
+    let original = "(version 1)\n(deny default)\n(deny network*)\n(deny file-write*)\n(deny mach-lookup (xpc-service-name-prefix \"\"))";
+    let mut policy = original.to_string();
+    enable(&mut policy).unwrap();
+    assert!(
+        policy.starts_with("(version 1)\n(deny default)\n(deny network*)\n(deny file-write*)\n")
+    );
+    let applied = policy.clone();
+    assert!(enable(&mut policy).is_err());
+    assert_eq!(policy, applied);
+}
